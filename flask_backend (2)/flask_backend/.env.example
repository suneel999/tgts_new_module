JWT_SECRET_KEY=generate-another-long-random-string

# RDS MySQL (ap-south-1) — replace USER, PASSWORD, DATABASE_NAME; URL-encode password (@ → %40)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@tgts-mysql-prod.ch4m6mm4g6qx.ap-south-1.rds.amazonaws.com:3306/DATABASE_NAME

PORT=5000
HOST=0.0.0.0

CORS_ORIGINS=https://admin.tgtccon2025.com
ADMIN_FRONTEND_URL=https://admin.tgtccon2025.com

RATELIMIT_ENABLED=True
